# Zonatic API Environment Variables
# Copy to .env and fill in values

# Database
# Format: postgresql+psycopg://user:password@host:port/database
# Supabase example: postgresql+psycopg://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Application environment
# development, staging, production
APP_ENV=development

# Optional: CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://console.zonatic.id
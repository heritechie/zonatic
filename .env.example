# Zonatic connects to its database exclusively via DATABASE_URL.
#
# For Supabase, paste the connection string from your project
#   Project Settings → Database → Connection string
#
# Use one of:
#   - Direct connection (for migrations / admin tasks):
#       postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   - Pooler / Supavisor connection (recommended for runtime, e.g. transaction mode):
#       postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Replace <project-ref>, <password>, and <region> with the values from your
# Supabase project. Never commit real values to source control.
DATABASE_URL=postgresql+psycopg://user:password@<supabase-host>:5432/postgres

# CORS origin allowlist consumed by console-api (comma-separated).
# Adjust to match the URL where you serve the Console UI.
CORS_ORIGINS=http://localhost:5173,http://localhost:80,https://console.zonatic.id

# Vite build-time GraphQL URL for the Console frontend.
# Leave as-is for local docker compose.
VITE_GRAPHQL_URL=http://localhost:8001/graphql

# ---------------------------------------------------------------------------
# Google sign-in (Supabase Auth)
# ---------------------------------------------------------------------------
# Google is the only authentication method in V1. The provider credentials live
# in Supabase (Authentication -> Providers -> Google), NOT here — this project
# never sees a Google client secret.
#
# SUPABASE_URL / SUPABASE_ANON_KEY are read by console-api to verify the access
# token that Supabase Auth issues. The anon key is a public, read-only key; it
# cannot read the database. Never use the service_role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
# Read by the Console frontend for the browser sign-in client.
# VITE_* values are baked into the client bundle at build time, so they must be
# public keys only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
# Marketing site origin, used by the login page's Terms/Privacy links.
VITE_CONSOLE_URL=https://console.zonatic.id
VITE_SITE_URL=https://www.zonatic.id

# Application runtime mode. "development" enables debug middleware.
APP_ENV=development